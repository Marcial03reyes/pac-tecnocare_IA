{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "artifacts/pac-tecnocare",
    "artifacts/api-server",
    "lib/api-client-react",
    "lib/api-zod"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace=@workspace/pac-tecnocare && npm run build --workspace=@workspace/api-server",
    "start": "node --env-file-if-exists=.env --enable-source-maps artifacts/api-server/dist/index.mjs",
    "test:portable": "node --test tests/portable.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
