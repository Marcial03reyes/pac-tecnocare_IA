# Public browser configuration, required before npm run build.
# Also required at runtime by the assistant's Supabase session validation.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# Server only. Never prefix with VITE_, commit, or pass to docker build.
GEMINI_API_KEY=YOUR_PRIVATE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview

PORT=3000
NODE_ENV=production
LOG_LEVEL=info
